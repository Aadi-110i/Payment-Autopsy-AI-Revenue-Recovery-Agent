# Autopsy - AI Revenue Recovery Agent
# Copy this file to .env and fill in your values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autopsy?schema=public"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ===========================================
# RAZORPAY TEST MODE
# ===========================================
# Get these from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ===========================================
# AI / LLM CONFIGURATION (Optional)
# ===========================================
# The system works with mock AI in demo mode
# Add real keys for production-quality explanations
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_PROVIDER="mock"  # Options: mock, openai, anthropic, openrouter

# ===========================================
# DEMO MODE
# ===========================================
# When true, uses synthetic data and simulated outcomes
DEMO_MODE=true

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL="info"